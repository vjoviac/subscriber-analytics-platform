# AWS
AWS_PROFILE=your-aws-profile
AWS_REGION=us-east-2
S3_BUCKET=your-bucket-name

# Pipeline
DEFAULT_EVENT_COUNT=500

# Local storage
DATA_DIRECTORY=data
RAW_DATA_DIRECTORY=data/raw
ENRICHED_DATA_DIRECTORY=data/enriched
CURATED_DATA_DIRECTORY=data/curated
HOURLY_ACTIVITY_DIRECTORY=data/curated/subscriber_activity_hourly
DAILY_ACTIVITY_DIRECTORY=data/curated/subscriber_activity_daily

# Observability
LOG_LEVEL=INFO
LOG_DIRECTORY=logs
REPORT_DIRECTORY=reports/pipeline_runs